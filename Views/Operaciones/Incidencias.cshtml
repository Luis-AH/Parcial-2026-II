@model IEnumerable<PlataformaIncidencias.Models.Incidencia>

@{
    ViewData["Title"] = "Plataforma de Incidencias";
}

<!-- RESOLUCIÓN 2: Se eligió un título definitivo que refleja las 3 funcionalidades
     integradas: búsqueda (Algolia), caché (Redis) y tiempo real (PieSocket). -->
<h1>Panel de Incidencias Abiertas</h1>

<div class="controls">
    <form method="get" action="/Operaciones/Incidencias" style="display:contents;">
        <div class="search-box">
            <input id="search-input" 
                   type="text" 
                   name="q"
                   value="@ViewBag.Query"
                   placeholder="Buscar por nombre de estación o descripción (Algolia)...">
        </div>
        <button type="submit" class="btn-elegante" style="margin-left:0.75rem;">Buscar</button>
    </form>
    <div class="stats" style="font-size: 0.875rem; color: #64748b; font-weight: 500;">
        @Model.Count() incidencias listadas
    </div>
</div>

<div class="table-container">
    <table class="bici-table" id="tabla-incidencias">
        <thead>
            <tr>
                <th>ID</th>
                <th>Estación</th>
                <th>Descripción</th>
                <th>Prioridad</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="incidencias-body">
            @foreach (var item in Model)
            {
                <tr id="row-@item.Id">
                    <td style="font-weight: 500; color: #64748b;">#@item.Id</td>
                    <td style="font-weight: 500;">@item.Estacion</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Prioridad</td>
                    <td>
                        @if (item.Estado == "Abierta")
                        {
                            <span class="badge-state open">Abierta</span>
                        }
                        else
                        {
                            <span class="badge-state closed">Cerrada</span>
                        }
                    </td>
                    <td>
                        @if (item.Estado == "Abierta")
                        {
                            <button class="btn-elegante btn-cerrar" onclick="cerrarIncidencia(@item.Id, this)">Cerrar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Empty State (oculto por defecto) -->
<div id="empty-state" class="empty-state" style="@(Model.Any() ? "" : "display: block;")">
    <h3>No se encontraron incidencias</h3>
    <p>Prueba buscando con otro nombre de estación o descripción.</p>
</div>

@section Scripts {
    <!-- Pusher JS SDK — compatible con PieSocket WebSockets -->
    <script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
    <script>
        // Búsqueda visual para ver el Empty State
        document.getElementById('search-input').addEventListener('input', function(e) {
            const text = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('#incidencias-body tr');
            let visibleCount = 0;
            
            rows.forEach(row => {
                if(row.style.opacity === '0') return; // ignorar cerradas/en proceso
                const content = row.textContent.toLowerCase();
                if (content.includes(text)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });
            
            document.querySelector('.table-container').style.display = visibleCount === 0 ? 'none' : 'block';
            document.getElementById('empty-state').style.display = visibleCount === 0 ? 'block' : 'none';
            document.querySelector('.stats').textContent = visibleCount + (visibleCount === 1 ? ' incidencia listada' : ' incidencias listadas');
        });

        // Llamada asíncrona real para cerrar incidencia
        async function cerrarIncidencia(id, btn) {
            btn.textContent = "Procesando...";
            btn.style.opacity = "0.5";
            btn.disabled = true;

            try {
                const response = await fetch(`/Operaciones/Cerrar/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                
                if (!response.ok) {
                    alert("Error al cerrar incidencia");
                    btn.textContent = "Cerrar";
                    btn.style.opacity = "1";
                    btn.disabled = false;
                }
            } catch (e) {
                console.error(e);
            }
        }

        // Helper para animar la desaparición de una fila
        function eliminarFila(id) {
            const row = document.getElementById(`row-${id}`);
            if (!row) return;
            row.style.transition = "opacity 0.4s ease";
            row.style.opacity = "0";
            setTimeout(() => {
                row.remove();
                document.getElementById('search-input').dispatchEvent(new Event('input'));
            }, 400);
        }

        // ---- Cliente PieSocket via SDK Pusher ----
        const pusher = new Pusher('jFcqhaByFMQp5iP05LgFlOwnBBWGJuFTcOflwHiO', {
            cluster:          'free.blr2',
            wsHost:           'free.blr2.piesocket.com',
            wsPort:           443,
            wssPort:          443,
            forceTLS:         true,
            enabledTransports: ['ws', 'wss'],
            disableStats:     true
        });

        const channel = pusher.subscribe('incidencias-channel');

        channel.bind('IncidenciaActualizada', function(data) {
            console.log('[PIESOCKET] Evento recibido:', data);
            // Dependiendo del serializador JSON, puede llegar como Id o id
            const incidenciaId = data.Id || data.id;
            eliminarFila(incidenciaId);
        });
    </script>
}
